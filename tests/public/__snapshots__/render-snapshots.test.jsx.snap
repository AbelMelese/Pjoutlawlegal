exports[`public site renders unchanged > footer 1`] = `"<footer class="relative overflow-hidden"><div class="relative overflow-hidden" style="background:linear-gradient(160deg, #1E3A5F 0%, #2A1F4E 40%, #5B2C6F 100%)"><div class="absolute inset-0 bg-[url(&#x27;https://grainy-gradients.vercel.app/noise.svg&#x27;)] opacity-5 pointer-events-none"></div><div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-16 relative z-10"><div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 md:gap-12"><div class="lg:col-span-1"><div class="mb-6"><h3 class="text-lg md:text-xl font-bold font-[&#x27;Playfair_Display&#x27;] text-white whitespace-nowrap">Phyllis J. Outlaw &amp; Associates</h3><p class="text-white/70 mt-2">Legal and mediation services grounded in preparation and professional service.</p></div><div class="flex gap-3"><a href="https://www.facebook.com/CLRCommunityEmpowerment/" target="_blank" rel="noreferrer" class="w-10 h-10 bg-white/10 rounded-full flex items-center justify-center text-white/60 hover:bg-white/20 hover:text-white transition-all duration-300 hover:-translate-y-1"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-facebook" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg></a><a href="https://www.youtube.com/channel/UCBD_unvoJ9pascMwOcYHpqg/videos" target="_blank" rel="noreferrer" class="w-10 h-10 bg-white/10 rounded-full flex items-center justify-center text-white/60 hover:bg-white/20 hover:text-white transition-all duration-300 hover:-translate-y-1"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-youtube" aria-hidden="true"><path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 