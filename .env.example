# Copy to .env for local development (never commit .env).
# In production, set these in Netlify: Site configuration > Environment variables.

# --- Public (built into the browser bundle; safe to expose) ---------------
# Supabase project URL and anon key (Project Settings > API).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Server only (Netlify Functions; NEVER prefix with VITE_) -------------
# Same project URL, plus the service role key. The service role key bypasses
# row level security: keep it only in Netlify's environment, scope "Functions".
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Netlify build hook (Site configuration > Build & deploy > Build hooks).
# Publishing in the dashboard calls this to rebuild the site.
NETLIFY_BUILD_HOOK_URL=

# Existing PayPal integration (unchanged).
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# --- Later phases (not used yet; listed so status checks are clear) -------
